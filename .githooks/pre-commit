#!/bin/sh
set -eu

# main só muda via PR (proteção no GitHub); barra o commit local antes do gate caro.
if [ "$(git symbolic-ref --short -q HEAD || true)" = "main" ]; then
  echo "Commit direto na main bloqueado: crie uma branch (git switch -c <nome>) e abra um PR." >&2
  exit 1
fi

# Testes e mutation testing usam o snapshot staged, não a árvore de trabalho.
cd "$(git rev-parse --show-toplevel)"
git diff --cached --check
# Infraestrutura alterada exige base completa, validada no CI; o commit valida o escopo do diff.
# A mutação tem limite de 5 min (MUTATION_TIME_LIMIT_SECONDS); estourou, fica só para o CI.
node scripts/mutation.mjs --staged --defer-full
